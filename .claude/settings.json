{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "shell": "powershell",
            "command": "if ((git status --porcelain) -and (Get-Command bundle -ErrorAction SilentlyContinue)) { bundle exec jekyll build }",
            "timeout": 60,
            "statusMessage": "jekyll build"
          }
        ]
      }
    ]
  }
}
